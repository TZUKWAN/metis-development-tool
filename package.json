{
  "name": "metis-development-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Metis Development Tool (MDT): design and build Agent applications like making a PowerPoint deck",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TZUKWAN/metis-development-tool.git"
  },
  "bugs": {
    "url": "https://github.com/TZUKWAN/metis-development-tool/issues"
  },
  "homepage": "https://github.com/TZUKWAN/metis-development-tool#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "format": "node tools/format-changed.mjs --write",
    "format:check": "node tools/format-changed.mjs --check",
    "check:theme-colors": "node tools/check-theme-colors.mjs",
    "check:english-comments": "node tools/check-english-comments.mjs",
    "lint": "eslint . --max-warnings=0",
    "fixtures": "npm run fixtures -w @genoffice/docx-engine",
    "test": "node tools/run-all-workspace-gates.mjs test",
    "typecheck": "node tools/run-all-workspace-gates.mjs typecheck",
    "notices": "node tools/gen-third-party-notices.mjs",
    "licenses": "node tools/check-licenses.mjs",
    "dev:mdt": "npm run dev -w @mdt/app",
    "test:mdt": "npm run test -w @mdt/app",
    "typecheck:mdt": "npm run typecheck -w @mdt/app",
    "build:mdt": "npm run build -w @mdt/app",
    "dist:win": "npm run build:mdt && npm run dist:win -w @mdt/app",
    "dist:mac": "npm run build:mdt && npm run dist:mac -w @mdt/app",
    "dist:linux": "npm run build:mdt && npm run dist:linux -w @mdt/app",
    "audit:tasks": "node tools/audit-task-status.mjs"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "overrides": {
    "nanoid@3": "^3.3.17",
    "nanoid@5": "^5.1.16"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
