{
  "name": "@mdt/app",
  "productName": "Metis Development Tool",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Metis Development Tool: design and build Agent applications like making a PowerPoint deck",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@genoffice/i18n": "*",
    "@genoffice/pipelines": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-ops": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/ui": "*",
    "@mdt/codex": "*",
    "@mdt/design": "*",
    "@mdt/schema": "*",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.6",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "konva": "^9.3.20",
    "opentype.js": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.0.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15",
    "axe-core": "^4.10.0"
  },
  "author": "MDT contributors",
  "build": {
    "appId": "com.metis.mdt",
    "productName": "Metis Development Tool",
    "executableName": "metis-development-tool",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronVersion": "43.3.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@genoffice/electron-utils": "*",
    "@mdt/capabilities": "*",
    "@mdt/project": "*",
    "acorn": "^8.18.0",
    "harfbuzzjs": "^1.4.0",
    "pngjs": "^7.0.0",
    "utif2": "^4.1.0"
  }
}
