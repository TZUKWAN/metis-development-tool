    "test:watch": "vitest",
    "gen:schema": "UPDATE_SCHEMA=1 vitest run tests/schema-artifact.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
