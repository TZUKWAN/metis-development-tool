{
  "name": "@mdt/schema",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "MDT project model: Zod schemas, stable IDs, reference integrity, migrations, deterministic BuildBlueprint",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
